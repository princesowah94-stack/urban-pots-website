      "settings": {
        "heading": "Check out some of our commercial planter designs",
        "subtext": "<p>Do you have commercial project that need large outdoor pots in the next 3-4 months? Save costs by letting us take care of your tender and ordering in advance</p>"
      }
    },
    "commercial_projects_info_grid_FbLUj9": {
      "type": "commercial-projects-info-grid",
      "blocks": {
        "text_item_rJFbK6": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-star",
            "item_title": "Excellence in Craftsmanship",
            "item_description": "Each commercial pot and custom planter is crafted with meticulous attention to detail by skilled tradespeople, leveraging years of expertise to ensure every piece not only meets but exceeds your expectations for quality, durability, and style."
          }
        },
        "text_item_n8fbPP": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-money-bill",
            "item_title": "Best Price Guarantee",
            "item_description": "Your satisfaction is our priority. We compare and match commercial planters and custom planters, working closely with you to ensure every order meets your specifications—delivering high-quality large outdoor planters at the best possible price across Australia."
          }
        },
        "text_item_hVwXmp": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-ruler-horizontal",
            "item_title": "Custom Sizes, Perfect Fit",
            "item_description": "Get the exact commercial or custom planter size you need—whether matching a competitor’s design at a better price or creating a large outdoor planter tailored specifically for your project."
          }
        },
        "text_item_PMj7JE": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-paint-roller",
            "item_title": "Tailored Dulux Colours",
            "item_description": "Every commercial or custom planter can be finished in your choice of Australian Dulux colours, ensuring a perfect match with your project’s palette. Using the same high-grade coatings specified for commercial buildings, our planters are built to withstand even the toughest Australian climates, combining durability with lasting aesthetic appeal."
          }
        },
        "text_item_tdmdCW": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-arrow-trend-up",
            "item_title": "Stock Availability",
            "item_description": "Chances are, we already have the commercial planters and custom planters you need in stock, minimizing delays and keeping your project on schedule. We provide Australia-wide delivery, serving everything from major cities to regional areas with large outdoor planters ready for installation."
          }
        },
        "text_item_3qjpap": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-clock",
            "item_title": "Fast & Reliable Lead Times",
            "item_description": "Whether you need in-stock commercial planters or custom sizes, we deliver quickly and reliably. Standard products are ready in as little as 2 weeks, while bespoke custom planters and large outdoor planters are completed within 7–12 weeks, depending on production capacity."
          }
        },
        "text_item_Td7dwP": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-gem",
            "item_title": "Extensive Range",
            "item_description": "Our extensive collection sets us apart in the world of commercial planters Australia. From durable planter shapes and colours perfect for large-scale projects such as apartment complexes and shopping centres, to bespoke custom planters tailored for premium developments, we provide solutions for every requirement. Our range includes GRC, Atlantis, Lightweight Terrazzo, and more, delivering large outdoor planters that combine style, durability, and functionality."
          }
        },
        "text_item_WpnGVR": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-earth-asia",
            "item_title": "Australian Owned & Operated",
            "item_description": "We are proudly 100% Australian owned and operated. As a family-run business, our experienced team specializes in commercial planters and custom planter solutions, committed to industry best practices to ensure every project delivers exceptional quality, durability, and value for your clients."
          }
        },
        "text_item_y3YPQW": {
          "type": "text_item",
          "settings": {
            "item_icon": "fa-solid fa-handshake-angle",
            "item_title": "Partnerships That Last",
            "item_description": "Our goal is to build enduring relationships within the commercial sector. We go beyond transactions, providing consistent service and meaningful results that leave a lasting impression. Your success is our highest priority."
          }
        }
      },
      "block_order": [
