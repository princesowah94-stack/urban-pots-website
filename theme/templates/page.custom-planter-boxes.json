    "testimonials_cpb": {
      "type": "testimonials",
      "blocks": {
        "quote_1": {
          "type": "quote",
          "settings": {
            "content": "<p>Urban Pots delivered custom fibre cement planters for our entire development on time and exactly to spec. Our landscaper was genuinely impressed. We'll be specifying them on every project going forward.</p>",
            "title": "James M.",
            "pos": "Property Developer, Sydney",
            "rating": 5
          }
        },
        "quote_2": {
          "type": "quote",
          "settings": {
            "content": "<p>As a landscaper I've sourced planters from all over Australia and Urban Pots is in a different league. Custom sizing, the paint finish, the turnaround — everything is professional. My clients are always impressed.</p>",
            "title": "Sarah R.",
            "pos": "Senior Landscaper, North Shore",
            "rating": 5
          }
        },
        "quote_3": {
          "type": "quote",
          "settings": {
            "content": "<p>We specified Urban Pots fibreglass planters for a luxury residential project in Mosman. The finish, the colour match, the consistency across 40+ pieces — flawless. Team was incredibly professional throughout.</p>",
            "title": "Alex K.",
            "pos": "Principal Architect, Eastern Suburbs",
            "rating": 5
          }
        }
      },
      "block_order": [
        "quote_1",
        "quote_2",
        "quote_3"
      ],
      "name": "Testimonials",
