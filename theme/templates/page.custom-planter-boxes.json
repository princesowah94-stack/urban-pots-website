    "custom_planter_boxes_section_ez9f6m": {
      "type": "custom-planter-boxes-section",
      "name": "Custom Planter Boxes",
      "settings": {
        "heading": "The custom planter partner for serious projects",
        "subtext": "Urban Pots manufactures precision-built planter boxes for property developers, landscapers, architects, and builders across Australia. Every order is custom-sized, primed, and finished with three coats of Dulux paint to your exact specification — in our Western Sydney yard. 2–8 week turnaround. Nationwide delivery. Bulk pricing available.",
        "show_button": false,
        "button_text": "Enquire Now"
      }
    },
