{% schema %}
{
  "name": "Customer Planter Form",
  "settings": [
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Title (Left Side)",
      "default": "Enquiry Form"
    },
    {
      "type": "textarea",
      "id": "form_description",
      "label": "Form Description (Left Side)",
      "default": "Fill in the details below and our team will get back to you."
    },
    {
      "type": "textarea",
      "id": "form_extra_text",
      "label": "Extra Text (Under Description)",
      "default": "We look forward to helping you with your custom planter needs."
    },
    {
      "type": "image_picker",
      "id": "form_image",
      "label": "Optional Image"
    },
    {
      "type": "text",
      "id": "form_title_inside",
      "label": "Form Title",
      "default": "Enquiry Form"
    },
    {
      "type": "textarea",
      "id": "form_description_inside",
      "label": "Form Description",
      "default": "Please fill in the form below and our team will get back to you within 24 hours."
    }
  ],
  "blocks": [
    {
      "type": "field",
      "name": "Form Field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Field Label",
          "default": "Your Field"
        },
        {
          "type": "select",
          "id": "field_type",
          "label": "Field Type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "email", "label": "Email" },
            { "value": "number", "label": "Number" },
            { "value": "textarea", "label": "Textarea" },
            { "value": "select", "label": "Dropdown" }
          ],
          "default": "text"
        },
        {
          "type": "text",
          "id": "options",
          "label": "Options (comma-separated for dropdown)",
          "default": "Option 1, Option 2"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required Field",
          "default": true
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout Style",
          "options": [
            { "value": "row", "label": "Row (side by side)" },
            { "value": "column", "label": "Column (stacked)" }
          ],
          "default": "column"
        }
      ]
    },
    {
      "type": "dimensions_group",
      "name": "Dynamic Dimensions Group",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Group Label",
          "default": "Dimensions"
        },
        {
          "type": "select",
          "id": "unit",
          "label": "Units",
          "options": [
            { "value": "mm", "label": "Millimeters (mm)" },
            { "value": "cm", "label": "Centimeters (cm)" },
            { "value": "in", "label": "Inches (in)" }
          ],
          "default": "cm"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout Style",
          "options": [
            { "value": "row", "label": "Row (side by side)" },
            { "value": "column", "label": "Column (stacked)" }
          ],
          "default": "row"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required Fields",
          "default": true
        },
        {
          "type": "text",
          "id": "dimension_labels",
          "label": "Dimension Labels (comma-separated)",
          "default": "Height, Length, Width"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Planter Form",
      "category": "Forms"
    }
  ]
}
{% endschema %}

<div id="enquiry-form-customer-planter-boxes" class="enquiry-wrapper container">
  {% if section.settings.form_title != blank or section.settings.form_description != blank %}
    <div class="enquiry-info">
      {% if section.settings.form_title != blank %}
        <h2 class="enquiry-title">{{ section.settings.form_title }}</h2>
      {% endif %}
      {% if section.settings.form_description != blank %}
        <p class="enquiry-description">{{ section.settings.form_description }}</p>
      {% endif %}
      {% if section.settings.form_extra_text != blank %}
        <p class="enquiry-extra-text">{{ section.settings.form_extra_text }}</p>
      {% endif %}
      {% if section.settings.form_image != blank %}
        <div class="enquiry-image">
          <img src="{{ section.settings.form_image | img_url: 'master' }}" alt="Form Image">
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="enquiry-form">
    {% if section.settings.form_title_inside != blank %}
      <h3 class="form-title">{{ section.settings.form_title_inside }}</h3>
    {% endif %}
    {% if section.settings.form_description_inside != blank %}
      <p class="form-description">{{ section.settings.form_description_inside }}</p>
    {% endif %}

    {% form 'contact', id: 'custom-enquiry-form' %}
      {% if form.posted_successfully? %}
        <div id="success-message">
          <p>
            Thank you for reaching out to us. We’ve successfully received your inquiry, and our team is already reviewing it. A dedicated team member will contact you within 24 hours to assist you further.
          </p>
        </div>
      {% else %}
        <div class="form-grid">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when "field" %}
                <div class="form-field {{ block.settings.layout }}" style="text-align: {{ block.settings.alignment }};">
                  <label>
                    {{ block.settings.label }}{% if block.settings.required %} *{% endif %}
                  </label>
                  {% case block.settings.field_type %}
                    {% when "text" %}
                      <input type="text" name="contact[{{ block.settings.label | handleize }}]" {% if block.settings.required %}required{% endif %}>
                    {% when "email" %}
                      <input type="email" name="contact[email]" {% if block.settings.required %}required{% endif %}>
                    {% when "number" %}
                      <input type="number" name="contact[{{ block.settings.label | handleize }}]" {% if block.settings.required %}required{% endif %}>
                    {% when "textarea" %}
                      <textarea name="contact[{{ block.settings.label | handleize }}]" {% if block.settings.required %}required{% endif %}></textarea>
                    {% when "select" %}
                      {% assign dropdown_options = block.settings.options | split: "," %}
                      <select name="contact[{{ block.settings.label | handleize }}]" {% if block.settings.required %}required{% endif %}>
                        {% for option in dropdown_options %}
                          {% assign option_clean = option | strip %}
                          <option value="{{ option_clean }}" {% if option_clean == 'Deliver' %}selected{% endif %}>
                            {{ option_clean }}
                          </option>
                        {% endfor %}
                      </select>
                  {% endcase %}
                </div>

              <!-- 🔹 Separate Address Fields under one label -->
              {% if block.settings.label contains "Delivery Method" %}
              <div id="delivery-address-field" style="width: 100%;">
                <div class="form-field" style="width: 100%;">
                  <label>Address *</label>
                  <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <div class="form-field" style="flex: 1;">
                      <input type="text" name="contact[number]" placeholder="Number" required>
                    </div>
                    <div class="form-field" style="flex: 1;">
                      <input type="text" name="contact[street]" placeholder="Street" required>
                    </div>
                    <div class="form-field" style="flex: 1;">
                      <input type="text" name="contact[suburb]" placeholder="Suburb" required>
                    </div>
                    <div class="form-field" style="flex: 1;">
                      <input type="text" name="contact[state]" placeholder="State" required>
                    </div>
                    <div class="form-field" style="flex: 1;">
                      <input type="text" name="contact[postcode]" placeholder="Postcode" required>
                    </div>
                    <div class="form-field" style="flex: 1;">
                      <input type="text" name="contact[country]" placeholder="Country" required>
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}





              {% when "dimensions_group" %}
                <div class="form-field dimensions-field {{ block.settings.layout }}">
                  <label>
                    {{ block.settings.label }}{% if block.settings.required %} *{% endif %}
                  </label>
                  {% assign dims = block.settings.dimension_labels | split: "," %}
                  <div class="dimension-group {{ block.settings.layout }}">
                    {% for dim in dims %}
                      <div class="dimension-item">
                        <input type="number" 
                          name="contact[{{ dim | strip | handleize }}]" 
                          placeholder="{{ dim | strip }} ({{ block.settings.unit }})"
                          {% if block.settings.required %}required{% endif %}>
                      </div>
                    {% endfor %}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>

        <button type="submit" class="enquiry-button">Submit Enquiry</button>
      {% endif %}
    {% endform %}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const deliveryMethod = document.querySelector('select[name="contact[delivery-method]"]');
  const addressField = document.getElementById('delivery-address-field');

  if (deliveryMethod && addressField) {
    if (deliveryMethod.value.trim().toLowerCase() === 'deliver') {
      addressField.style.display = 'flex';
    } else {
      addressField.style.display = 'none';
    }

    deliveryMethod.addEventListener('change', function () {
      if (this.value.trim().toLowerCase() === 'deliver') {
        addressField.style.display = 'flex';
      } else {
        addressField.style.display = 'none';
      }
    });
  }
});

</script>




<style>
/* Keep all your existing styles */
.enquiry-title { font-family: "Times New Roman", Times, serif; font-size: 28px; font-weight: 400; margin-bottom: 10px; }
.enquiry-description { font-size: 1.9rem !important; }
.enquiry-wrapper { display: flex; gap: 90px; align-items: flex-start; justify-content: space-between; max-width: 1200px; margin: 0 auto; padding: 60px 20px; }
.enquiry-info { flex: 1; }
.enquiry-form { flex: 1; background: #fff; padding: 30px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.form-title { font-size: 2.4rem; margin-bottom: 0.5rem; }
.form-description { font-size: 1.4rem; margin-bottom: 2rem; color: #555; }
.form-grid { display: flex; flex-wrap: wrap; gap: 20px; }
.form-field.row { flex: 1 1 45%; }
.form-field.column { flex: 1 1 100%; }
.form-field label { display: block; margin-bottom: 8px; font-weight: 600; }
input, textarea, select { width: 100%; border: 1px solid #ddd; border-radius: 6px; font-size: 1.5rem; background-color: #fff; color: #000; appearance: none; -webkit-appearance: none; -moz-appearance: none; }
.enquiry-button { margin-top: 20px; padding: 12px 24px; border: 2px solid black; background: transparent; color: black; cursor: pointer; font-weight: bold; transition: all 0.3s ease; width: 100%; }
.enquiry-button:hover { background: black; color: white; }
#success-message { font-size: 2rem; padding: 20px; color: #000; text-align: center; }
.enquiry-extra-text { font-size: 1.9rem; margin-top: 50px; color: #555; }
.enquiry-image img { width: 100%; height: auto; border-radius: 6px; }
#AddressLabel { display: block; margin-bottom: 8px; font-weight: 600; }
/* 🔹 Dimensions styling */
.dimensions-field { width: 100%; }
.dimension-group { display: flex; gap: 10px; flex-wrap: wrap; }
.dimension-group.row > div { flex: 1; }
.dimension-group.column { flex-direction: column; }
.dimension-group input { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 1.4rem; }
.unit-label { margin-top: 5px; font-size: 1.3rem; color: #555; }
#delivery-address-field { display: flex; gap: 10px; flex-wrap: wrap; }
#delivery-address-field .form-field input { width: 100%; padding-left:1px;padding-right:1px;text-align:center}
@media (max-width: 768px) {
  .enquiry-wrapper { flex-direction: column; gap: 40px; }
  .enquiry-info { order: -1; text-align: center; }
  .enquiry-title { font-size: 20px; }
  .enquiry-description, .enquiry-extra-text { font-size: 1.5rem !important; },
  #delivery-address-field > div > div[style*="flex: 1"] {
    flex: 1 1 auto !important;
    min-width: 80px !important;
    white-space: nowrap !important;
  }

  /* Force all inputs to stay in one row */
  #delivery-address-field > div[style*="display: flex"] {
    flex-wrap: nowrap !important;
    overflow-x: auto;
  }
}


</style>
