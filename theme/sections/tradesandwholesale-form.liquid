{% schema %}
{
  "name": "Trades and Wholesale",
  "tag": "section",
  "class": "custom-contact-form",
  "settings": [],
  "presets": [
    {
      "name": "Trades and Wholesale",
      "category": "Contact"
    }
  ]
}
{% endschema %}

<div class="modern-form-wrapper">
  <div class="modern-form">
    <h2 class="form-heading">Trades & Wholesale Enquiries</h2>
    <form method="post" action="/contact#modern-form" id="modern-form" accept-charset="UTF-8">
      <input type="hidden" name="form_type" value="contact" />
      <input type="hidden" name="utf8" value="✓" />

      <div class="form-group">
        <label for="ContactFormName">Name</label>
        <input type="text" id="ContactFormName" name="contact[name]" placeholder="Your name here" required>
      </div>

      <div class="form-group">
        <label for="ContactFormEmail">Email</label>
        <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="you@example.com" required>
      </div>

      <div class="form-group">
        <label for="ContactFormPhone">Contact Number</label>
        <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="+61 412 345 678">
      </div>

      <div class="form-group">
        <label for="ContactFormABN">ABN</label>
        <input type="text" id="ContactFormABN" name="contact[abn]" placeholder="12 345 678 901">
      </div>

      <div class="form-group">
        <label for="ContactFormWebsite">Website</label>
        <input type="url" id="ContactFormWebsite" name="contact[website]" placeholder="https://yourwebsite.com">
      </div>

     <div class="form-button-wrapper">
      <button type="submit" class="submit-button">Submit</button>
    </div>

    </form>
  </div>
</div>

<style>
.modern-form-wrapper {
  max-width: 640px;
  margin: 50px auto;
  padding: 60px 20px;
  background: #DCD7C9;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
  color: #ffffff;
}

.modern-form {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.form-heading {
  font-size: 2.5rem;
  font-weight: 700;
  text-align: center;
  margin-bottom: 1rem;
  color: #ffffff;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-group label {
  font-weight: 600;
  margin-bottom: 0.6rem;
  font-size: 1.3rem;
  color: #ffffff;
}

.form-group input {
  font-size: 1.3rem;
  padding: 14px 0;
  background-color: transparent;
  border: none;
  border-bottom: 2px solid #ffffff;
  color: #2c2c2c;
  transition: border-color 0.3s, box-shadow 0.3s;
}

.form-group input::placeholder {
  font-size: 1.2rem;
  color: rgba(255, 255, 255, 0.7);
}

.form-group input:focus {
  border-color: #2c2c2c;
  outline: none;
  box-shadow: 0 2px 0 0 rgba(44, 44, 44, 0.3);
}

.form-button-wrapper {
  text-align: center;
}

.submit-button {
  background-color: #2c2c2c;
  color: #ffffff;
  padding: 16px 24px;
  font-size: 1.2rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.3s;
  margin-top: 1rem;
  width: 50%;
  margin-left: auto;
  margin-right: auto;
}

.submit-button:hover {
  background-color: #57524a;
}

@media (max-width: 480px) {
  .form-heading {
    font-size: 2rem;
  }

  .form-group label,
  .form-group input,
  .form-group input::placeholder {
    font-size: 1.1rem;
  }

  .submit-button {
    font-size: 1.05rem;
    padding: 14px 18px;
  }
}
</style>



