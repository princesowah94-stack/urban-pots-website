{% schema %}
{
  "name": "Collection Showcase",
  "settings": [
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Paragraph Text",
      "default": "Discover our curated collections designed to inspire your lifestyle."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Number of columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" }
      ],
      "default": "4/3"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Shop the latest trends"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modern Collection Showcase",
      "category": "Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

<section class="modern-collections page-width">
  {% if section.settings.intro_text != blank %}
    <p class="modern-collections__intro">{{ section.settings.intro_text }}</p>
  {% endif %}

  <div class="modern-collections__grid columns-{{ section.settings.columns }}">
    {% for block in section.blocks %}
      {% assign coll = collections[block.settings.collection] %}
      {% if coll %}
        <div class="modern-collections__item">
          <a href="{{ coll.url }}" class="modern-collections__link">
            <div class="modern-collections__image" style="--aspect-ratio: {{ section.settings.aspect_ratio }};">
              {% if coll.image %}
                <img
                  src="{{ coll.image | img_url: '800x800' }}"
                  alt="{{ coll.title | escape }}"
                  loading="lazy"
                >
              {% endif %}
              <div class="modern-collections__overlay">
                <h3 class="modern-collections__title">{{ coll.title }}</h3>
                {% if block.settings.subtitle != blank %}
                  <p class="modern-collections__subtitle">{{ block.settings.subtitle }}</p>
                {% endif %}
              </div>
            </div>
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
.modern-collections {
  margin: 3rem auto;
  text-align: center;
  max-width: 1200px; /* ✅ Prevent full width */
}
.modern-collections__intro {
  max-width: 800px;
  margin: 0 auto 2rem;
  margin-bottom: 5rem;
  font-size: 2.5rem;
  font-weight: 400;
  font-family: "Times New Roman", Times, serif;
  color: #000;
}
.modern-collections__grid {
  display: grid;
  gap: 1.5rem;
}
.modern-collections__grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
.modern-collections__grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
.modern-collections__grid.columns-4 { grid-template-columns: repeat(4, 1fr); }
.modern-collections__grid.columns-5 { grid-template-columns: repeat(5, 1fr); }

.modern-collections__item {
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.modern-collections__item:hover {
  transform: translateY(-6px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}
.modern-collections__image {
  position: relative;
  width: 100%;
  aspect-ratio: var(--aspect-ratio);
  overflow: hidden;
}
.modern-collections__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.modern-collections__item:hover img {
  transform: scale(1.08);
}

.modern-collections__overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.2rem;
  background: linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0));
  color: #fff;
  text-align: left;
}
.modern-collections__title {
  font-family: "Times New Roman", Times, serif;
  font-size: 1.6rem;
  font-weight: 700;
  margin: 0;
}
.modern-collections__subtitle {
  font-size: 1.3rem;
  opacity: 0.9;
  margin-top: 0.25rem;
  font-family: Arial, Helvetica, sans-serif;
}

/* ✅ Responsive */
@media (max-width: 1024px) {
  .modern-collections__grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
}
@media (max-width: 640px) {
  
  .modern-collections__grid {
    grid-template-columns: 1fr !important;
    margin:0px 20px;
  }
  .modern-collections__title {
    font-size: 1.3rem;
  }
  .modern-collections__subtitle {
    font-size: 1rem;
  }
  .modern-collections__intro {
    font-size: 1.3rem;
    padding: 0 1rem;
  }
}
</style>
