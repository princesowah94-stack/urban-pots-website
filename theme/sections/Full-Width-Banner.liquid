<section class="up-banner-slider">
  <div class="up-banner-overlay"></div>
  <div class="up-banner-content">
    <p class="up-banner-eyebrow">{{ section.settings.eyebrow | default: 'Handcrafted in Western Sydney' }}</p>
    <h1 class="up-banner-title">{{ section.settings.heading | default: 'Spaces That Demand to Be Noticed' }}</h1>
    <p class="up-banner-text">{{ section.settings.subtext | default: 'Premium custom planter boxes for developers, architects, and landscapers across Australia.' }}</p>
    <a href="{{ section.settings.button_link | default: '/pages/custom-planter-boxes' }}" class="up-banner-btn">
      {{ section.settings.button_text | default: 'Explore Custom Planters' }}
    </a>
  </div>

  <div class="up-banner-slider-wrapper">
    {% for block in section.blocks %}
      <div class="up-banner-slide" style="background-image: url({{ block.settings.banner_image | image_url: width: 2048 }});"></div>
    {% endfor %}
  </div>

  <button class="up-banner-arrow up-banner-prev" aria-label="Previous slide">&#10094;</button>
  <button class="up-banner-arrow up-banner-next" aria-label="Next slide">&#10095;</button>
  <div class="up-banner-dots"></div>
</section>

<style>
.up-banner-slider {
  position: relative;
  width: 100%;
  height: 88vh;
  min-height: 560px;
  max-height: 860px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
}
.up-banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    155deg,
    rgba(12,10,8,0.08) 0%,
    rgba(12,10,8,0.52) 55%,
    rgba(12,10,8,0.80) 100%
  );
  z-index: 2;
}
.up-banner-content {
  position: relative;
  z-index: 3;
  color: #fff;
  max-width: 820px;
  padding: 0 clamp(1.5rem, 5vw, 6rem) clamp(3rem, 6vw, 6rem);
  text-align: left;
}
.up-banner-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-family: 'Inter', Helvetica, sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #C9B99A;
  margin-bottom: 1.25rem;
}
.up-banner-eyebrow::before {
  content: '';
  width: 22px;
  height: 1px;
  background: #C9B99A;
  flex-shrink: 0;
}
.up-banner-title {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-size: clamp(3rem, 7vw, 6.5rem) !important;
  font-weight: 600 !important;
  line-height: 0.95 !important;
  letter-spacing: -0.02em !important;
  color: #fff !important;
  margin-bottom: 1.25rem;
}
.up-banner-text {
  font-family: 'Inter', Helvetica, sans-serif;
  font-size: clamp(0.88rem, 1.3vw, 1rem);
  font-weight: 300;
  color: rgba(255,255,255,0.65);
  line-height: 1.75;
  max-width: 480px;
  margin-bottom: 2rem;
}
.up-banner-btn {
  display: inline-block;
  padding: 0.85rem 2rem;
  background: #C9B99A;
  color: #1C1A18;
  text-decoration: none;
  font-family: 'Inter', Helvetica, sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 2px;
  transition: background 0.25s, transform 0.2s;
}
.up-banner-btn:hover {
  background: #D9C9AA;
  transform: translateY(-2px);
}
.up-banner-slider-wrapper {
  position: absolute;
  inset: 0;
  display: flex;
  width: 100%;
  height: 100%;
  transition: transform 1s ease-in-out;
  z-index: 1;
}
.up-banner-slide {
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
}
.up-banner-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 4;
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.7);
  font-size: 1.4rem;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  border-radius: 50%;
  transition: background 0.25s, color 0.25s;
}
.up-banner-arrow:hover {
  background: rgba(0,0,0,0.6);
  color: #fff;
}
.up-banner-prev { left: 1.5rem; }
.up-banner-next { right: 1.5rem; }
.up-banner-dots {
  position: absolute;
  bottom: 1.5rem;
  right: 2rem;
  display: flex;
  gap: 6px;
  z-index: 4;
}
.up-banner-dots button {
  all: unset;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255,255,255,0.4);
  cursor: pointer;
  transition: background 0.3s, transform 0.2s;
  display: inline-block;
}
.up-banner-dots button.active {
  background: #C9B99A;
  transform: scale(1.4);
}
@media (max-width: 768px) {
  .up-banner-slider { height: 92vh; min-height: 480px; }
  .up-banner-arrow { display: none; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const slider = document.querySelector('.up-banner-slider-wrapper');
  if (!slider) return;
  const slides = document.querySelectorAll('.up-banner-slide');
  const prev = document.querySelector('.up-banner-prev');
  const next = document.querySelector('.up-banner-next');
  const dotsContainer = document.querySelector('.up-banner-dots');
  const total = slides.length;
  let index = 0, autoSlide;

  for (let i = 0; i < total; i++) {
    const dot = document.createElement('button');
    dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
    if (i === 0) dot.classList.add('active');
    dot.addEventListener('click', () => goToSlide(i));
    dotsContainer.appendChild(dot);
  }
  const dots = dotsContainer.querySelectorAll('button');

  function updateDots() {
    dots.forEach(d => d.classList.remove('active'));
    if (dots[index]) dots[index].classList.add('active');
  }
  function showSlide() {
    slider.style.transform = `translateX(-${index * 100}%)`;
    updateDots();
  }
  function goToSlide(i) { index = i; showSlide(); }
  function nextSlide() { index = (index + 1) % total; showSlide(); }
  function prevSlide() { index = (index - 1 + total) % total; showSlide(); }

  next.addEventListener('click', nextSlide);
  prev.addEventListener('click', prevSlide);

  function autoPlay() { autoSlide = setInterval(nextSlide, 5500); }
  function stopAuto() { clearInterval(autoSlide); }

  showSlide();
  autoPlay();
  document.querySelector('.up-banner-slider').addEventListener('mouseenter', stopAuto);
  document.querySelector('.up-banner-slider').addEventListener('mouseleave', autoPlay);
});
</script>

{% schema %}
{
  "name": "Hero Banner Carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Handcrafted in Western Sydney" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spaces That Demand to Be Noticed" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Premium custom planter boxes for developers, architects, and landscapers across Australia." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Explore Custom Planters" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner Image",
      "settings": [
        { "type": "image_picker", "id": "banner_image", "label": "Background Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Carousel",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
