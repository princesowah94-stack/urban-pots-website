{% schema %}
{
  "name": "Custom Enquiry Form",
  "settings": [
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Title (Left Side)",
      "default": "Enquiry Form"
    },
    {
      "type": "textarea",
      "id": "form_description",
      "label": "Form Description (Left Side)",
      "default": "Fill in the details below and our team will get back to you."
    },
    {
    "type": "text",
    "id": "form_title_inside",
    "label": "Form Title",
    "default": "Enquiry Form"
  },
  {
    "type": "textarea",
    "id": "form_description_inside",
    "label": "Form Description",
    "default": "Please fill in the form below and our team will get back to you within 24 hours."
  }

  ],
  "blocks": [
    {
      "type": "field",
      "name": "Form Field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Field Label",
          "default": "Your Field"
        },
        {
          "type": "select",
          "id": "field_type",
          "label": "Field Type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "email", "label": "Email" },
            { "value": "number", "label": "Number" },
            { "value": "textarea", "label": "Textarea" },
            { "value": "select", "label": "Dropdown" }
          ],
          "default": "text"
        },
        {
          "type": "text",
          "id": "options",
          "label": "Options (comma-separated for dropdown)",
          "default": "Option 1, Option 2"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required Field",
          "default": true
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout Style",
          "options": [
            { "value": "row", "label": "Row (side by side)" },
            { "value": "column", "label": "Column (stacked)" }
          ],
          "default": "column"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Enquiry Form",
      "category": "Forms"
    }
  ]
}
{% endschema %}

{% if request.path == '/pages/commercial-planters' %}
<div id="enquiry-form" class="enquiry-wrapper container">
  {% if section.settings.form_title != blank or section.settings.form_description != blank %}
    <div class="enquiry-info">
      {% if section.settings.form_title != blank %}
        <h2 class="enquiry-title">{{ section.settings.form_title }}</h2>
      {% endif %}
      {% if section.settings.form_description != blank %}
        <p class="enquiry-description">{{ section.settings.form_description }}</p>
      {% endif %}

      <!-- PDF Download Button -->
      <a href="https://cdn.shopify.com/s/files/1/0748/4152/2498/files/Urban_Pots_Commercial_Planters.pdf?v=1760602395" download class="download-button">
        Download our Custom 2025–2026 Commercial Planters Design and Sizes
      </a>
    </div>
  {% endif %}

  <div class="enquiry-form">
    {% if section.settings.form_title_inside != blank %}
      <h3 class="form-title">{{ section.settings.form_title_inside }}</h3>
    {% endif %}
    {% if section.settings.form_description_inside != blank %}
      <p class="form-description">{{ section.settings.form_description_inside }}</p>
    {% endif %}

    {% form 'contact', id: 'custom-enquiry-form' %}
      {% if form.posted_successfully? %}
        <div id="success-message">
          <p>
            Thank you for reaching out to us. We’ve successfully received your inquiry, and our team is already reviewing it. A dedicated team member will contact you within 24 hours to assist you further.
          </p>
        </div>
      {% else %}
        <div class="form-grid">
          {% for block in section.blocks %}
            <div class="form-field {{ block.settings.layout }}" style="text-align: {{ block.settings.alignment }};">
              <label>
                {{ block.settings.label }}{% if block.settings.required %} *{% endif %}
              </label>

              {% case block.settings.field_type %}
                {% when "text" %}
                  <input type="text" name="contact[{{ block.settings.label | handleize }}]" {% if block.settings.required %}required{% endif %}>
                {% when "email" %}
                  <input type="email" name="contact[email]" {% if block.settings.required %}required{% endif %}>
                {% when "number" %}
                  <input type="number" name="contact[{{ block.settings.label | handleize }}]" {% if block.settings.required %}required{% endif %}>
                {% when "textarea" %}
                  <textarea name="contact[{{ block.settings.label | handleize }}]" {% if block.settings.required %}required{% endif %}></textarea>
                {% when "select" %}
                  {% assign dropdown_options = block.settings.options | split: "," %}
                  <select name="contact[{{ block.settings.label | handleize }}]" {% if block.settings.required %}required{% endif %}>
                    {% for option in dropdown_options %}
                      <option value="{{ option | strip }}">{{ option | strip }}</option>
                    {% endfor %}
                  </select>
              {% endcase %}
            </div>
          {% endfor %}
        </div>

        <button type="submit" class="enquiry-button">Submit Tender</button>
      {% endif %}
    {% endform %}
  </div>
</div>
{% endif %}


<style>
.enquiry-title {
  font-family: "Times New Roman", Times, serif;
  font-size: 28px;
  font-weight: 400;
  margin-bottom: 10px;
}
.enquiry-description {
  font-size: 1.9rem !important;
}
.enquiry-wrapper {
  display: flex;
  gap: 90px;
  align-items: flex-start;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
  padding: 60px 20px;
}
.enquiry-info {
  flex: 1;
}
.download-button {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 24px;
  background: transparent;
  border: 2px solid black;
  color: black;
  text-decoration: none;
  font-weight: bold;
  transition: all 0.3s ease;
}
.download-button:hover {
  background: black;
  color: white;
}
.enquiry-form {
  flex: 1;
  background: #fff;
  padding: 30px;
  border-radius: 6px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.form-title {
  font-size: 2.4rem;
  margin-bottom: 0.5rem;
}
.form-description {
  font-size: 1.4rem;
  margin-bottom: 2rem;
  color: #555;
}
.form-grid { 
  display: flex; 
  flex-wrap: wrap; 
  gap: 20px; 
}
.form-field.row { 
  flex: 1 1 45%; 
}
.form-field.column { 
  flex: 1 1 100%; 
}
.form-field label { 
  display: block; 
  margin-bottom: 8px; 
  font-weight: 600; 
}
input, textarea, select {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 1.5rem;
}
.enquiry-button {
  margin-top: 20px;
  padding: 12px 24px;
  border: 2px solid black;
  background: transparent;
  color: black;
  cursor: pointer;
  font-weight: bold;
  transition: all 0.3s ease;
  width: 100%;
}
.enquiry-button:hover {
  background: black;
  color: white;
}
#success-message {
  font-size: 2rem;
  padding: 20px;
  color: #000;
  text-align: center;
}
@media (max-width: 768px) {
  .enquiry-wrapper {
    flex-direction: column;
    gap: 40px;
  }
  .enquiry-info {
    order: -1;
    text-align: center;
  }
  .enquiry-title {
    font-size: 20px;
  }
  .enquiry-description {
    font-size: 1.5rem !important;
  }
  .download-button {
    display: block;
    width: 100%;
    text-align: center;
  }
}
</style>
