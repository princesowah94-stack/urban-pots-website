<section class="custom-banner" style="position: relative; text-align: center; top:0px">
  {% if section.settings.banner_image %}
    <div class="banner-image-wrapper">
      <img 
        src="{{ section.settings.banner_image | image_url: width: 2000 }}" 
        alt="custom planter boxes australia" 
      >

      <!-- ✅ Content now inside wrapper -->
      <div class="banner-content">
        {% if section.settings.banner_heading != blank %}
          <h2 class="banner-title">{{ section.settings.banner_heading }}</h2>
        {% endif %}

        {% if section.settings.banner_text != blank %}
          <p class="banner-text">
            {{ section.settings.banner_text }}
          </p>
        {% endif %}

        {% if section.settings.banner_button_text != blank %}
          {% if section.settings.banner_button_action == "scroll" %}
            <a href="#enquiry-form-customer-planter-boxes" class="banner-button">
              {{ section.settings.banner_button_text }}
            </a>
          {% else %}
            <a href="{{ section.settings.banner_button_link }}" class="banner-button">
              {{ section.settings.banner_button_text }}
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

<style>
.custom-banner {
  position: relative;
  margin-top: 0;
  padding-top: 0;
  text-align: center;
}



/* ✅ Keep image boxed */
.banner-image-wrapper {
  position: relative;
  max-width: 1200px; /* adjust width here */
  margin: 0 auto;
}

.banner-image-wrapper img {
  width: 100%;
  height: 600px;
  object-fit: cover;
}

/* ✅ Content is centered inside image */
.banner-content {
  position: absolute;
  top: 50%;  
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  color: #fff;
  max-width: 800px;
  padding: 20px;
}

.banner-title {
  font-family: "Times New Roman", serif;
  font-size: 3.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color:#fff;
}

.banner-text{
    font-size: 2.5rem; 
    margin: 0 auto 2rem; 
    line-height: 1.4;
}

.banner-button {
  display: inline-block; 
  padding: 0.9rem 2rem;
  background: #fff; 
  color: #000; 
  text-decoration: none; 
  border-radius: 8px; 
  font-weight: 600; 
  font-size: 1.6rem;
  white-space: nowrap;
  transition: all 0.3s ease;
  animation: pulse 1.8s infinite;
}
.banner-button:hover {
  background: #000;
  color: #fff;
}

/* Pulse Animation */
@keyframes pulse {
  0% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255,255,255, 0.6);
  }
  70% {
    transform: scale(1.05);
    box-shadow: 0 0 0 20px rgba(255,255,255, 0);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255,255,255, 0);
  }
}

@media(max-width:600px){
    .banner-title {
        font-size:2.5rem;
        width:100%;
    }
    .banner-text {
        font-size:1.7rem;
    }
    .banner-button {
        font-size:1.3rem;
    }
    .banner-content {
        width:100%;
        margin:0px;
        padding-left:10px;
        padding-right:10px;
    }
}
</style>



{% schema %}
{
  "name": "Custom Planter Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Heading",
      "default": "Custom Planter Boxes"
    },
    {
      "type": "textarea",
      "id": "banner_text",
      "label": "Text",
      "default": "Showcase your unique planter boxes with a strong visual banner."
    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Button Text",
      "default": "Inquire Now"
    },
    {
      "type": "select",
      "id": "banner_button_action",
      "label": "Button Action",
      "options": [
        { "value": "scroll", "label": "Scroll to Enquiry Form" },
        { "value": "link", "label": "Go to a Page" }
      ],
      "default": "scroll"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Page Link (used if 'Go to a Page' is selected)",
      "default": "/"
    }
  ],
  "presets": [
    {
      "name": "Custom Planter Banner"
    }
  ]
}
{% endschema %}

