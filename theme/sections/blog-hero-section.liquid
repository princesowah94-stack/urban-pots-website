
<section class="custom-banner" style="position: relative; text-align: center;">
  {% if section.settings.banner_image %}
    <div class="banner-image-wrapper">
      <img 
        src="{{ section.settings.banner_image | image_url: width: 2000 }}" 
        alt="{{ section.settings.banner_heading | escape }}" 
      >
    </div>
  {% endif %}

  <div class="banner-content">
    {% if section.settings.banner_heading != blank %}
      <h1 class="banner-title">{{ section.settings.banner_heading }}</h1>
    {% endif %}

    {% if section.settings.banner_text != blank %}
      <p class="banner-text">
        {{ section.settings.banner_text }}
      </p>
    {% endif %}

    {% if section.settings.banner_button_text != blank %}
      {% if section.settings.banner_button_action == "scroll" %}
        <a href="#featured-articles" class="banner-button">
          {{ section.settings.banner_button_text }}
        </a>
      {% else %}
        <a href="{{ section.settings.banner_button_link }}" class="banner-button">
          {{ section.settings.banner_button_text }}
        </a>
      {% endif %}
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Blog Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Heading",
      "default": "Urbanpots Blog"
    },
    {
      "type": "textarea",
      "id": "banner_text",
      "label": "Subtext",
      "default": "Tips, inspiration, and guides for plant enthusiasts, homeowners, and designers. Discover how to style, care for, and enjoy greenery in every space."
    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Button Text",
      "default": "Explore Articles"
    },
    {
      "type": "select",
      "id": "banner_button_action",
      "label": "Button Action",
      "options": [
        { "value": "scroll", "label": "Scroll to Blog List" },
        { "value": "link", "label": "Go to a Page" }
      ],
      "default": "scroll"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Page Link (used if 'Go to a Page' is selected)"
    }
  ],
  "presets": [
    {
      "name": "Blog Hero Banner"
    }
  ]
}
{% endschema %}

<!-- JSON-LD for SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "{{ section.settings.banner_heading | escape }}",
  "url": "{{ shop.url }}/blogs",
  "description": "{{ section.settings.banner_text | escape }}",
  "publisher": {
    "@type": "Organization",
    "name": "{{ shop.name | escape }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ 'logo.png' | asset_url }}"
    }
  }
}
</script>

<style>
  html {
  scroll-behavior: smooth;
}

.banner-title {
  font-size: 3.9rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color:#fff;
}

.banner-text{
    font-size: 2.5rem; 
    margin: 0 auto 2rem; 
    line-height: 1.4;
}

.banner-button {
  display: inline-block; 
  padding: 1rem 2.2rem;
  background: #fff; 
  color: #000; 
  text-decoration: none; 
  border-radius: 10px; 
  font-weight: 600; 
  font-size: 1.6rem;
  white-space: nowrap;
  transition: all 0.3s ease;
  animation: pulse 1.8s infinite;
}
.banner-button:hover {
  background: #000;
  color: #fff;
}

.banner-image-wrapper {
  max-width: 1200px; /* not fullwidth */
  margin: 0 auto;
}
.banner-image-wrapper img {
  width: 100%;
  height: 600px;
  object-fit: cover;
}

.banner-content {
  position: absolute; 
  top: 50%; 
  left: 50%; 
  transform: translate(-50%, -50%); 
  color: #fff; 
  text-align: center; 
  max-width: 850px; 
  padding: 20px;
}

/* Pulse Animation */
@keyframes pulse {
  0% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255,255,255, 0.6);
  }
  70% {
    transform: scale(1.05);
    box-shadow: 0 0 0 20px rgba(255,255,255, 0);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255,255,255, 0);
  }
}
@media(max-width:600px){
    .banner-title {
        font-size:2.5rem;
        width:100%;
    }
    .banner-text {
        font-size:1.7rem;
    }
    .banner-button {
        font-size:1.3rem;
    }
    .banner-content {
        width:100%;
        margin:0px;
        padding-left:10px;
        padding-right:10px;
    }
}
</style>
