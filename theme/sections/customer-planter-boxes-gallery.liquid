
<div class="modern-columns-wrapper">
  <div class="single-column {% if section.settings.swap_order %}reverse{% endif %} {% if section.blocks.size == 0 %}no-bullets{% endif %}">
    <div class="text-content">
      <h3>{{ section.settings.heading }}</h3>
      <p class="subtext">{{ section.settings.text }}</p>

      {% if section.blocks.size > 0 %}
      <ul class="checklist">
        {% for block in section.blocks %}
          {% if block.type == 'bullet' %}
            <li>{{ block.settings.text }}</li>
          {% endif %}
        {% endfor %}
      </ul>
      {% endif %}

      {% if section.settings.show_button %}
        {% if section.settings.button_label != blank %}
          {% case section.settings.button_action %}
            {% when "scroll" %}
              <a href="#enquiry-form-customer-planter-boxes" class="btn">
                {{ section.settings.button_label }}
              </a>
            {% when "link" %}
              <a href="{{ section.settings.button_link | default: '#' }}" class="btn">
                {{ section.settings.button_label }}
              </a>
            {% when "collection" %}
              <a href="#custom-planter-boxes-grid" class="btn">
                {{ section.settings.button_label }}
              </a>
          {% endcase %}
        {% endif %}
      {% endif %}


    </div>

    {% if section.settings.image %}
      <div class="image-wrapper">
        <div class="rectangle-bg"></div>
        <div class="column-image">
          <img 
            src="{{ section.settings.image | img_url: '1200x' }}" 
            alt="{{ section.settings.heading }}"
            class="main-img">
          {% if section.settings.hover_image %}
          <img 
            src="{{ section.settings.hover_image | img_url: '1200x' }}" 
            alt="{{ section.settings.heading }} hover"
            class="hover-img">
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
html {
  scroll-behavior: smooth;
}
/* Wrapper */
.modern-columns-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 50px 20px;
  background-color: #fff;
  position: relative;
  z-index: 1;
}

/* Layout */
.single-column {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 3rem;
  position: relative;
  z-index: 2;
}

.single-column.reverse {
  flex-direction: row-reverse;
}

.single-column.no-bullets {
  align-items: flex-start;
}

/* Text Content */
.text-content {
  flex: 1;
  position: relative;
  z-index: 3;
}

.text-content h3 {
  font-family: 'Times New Roman', Times, serif;
  font-size: 3.5rem;
  font-weight: 400;
  margin-bottom: 0.8rem;
  color: #111;
}

.text-content .subtext {
  font-size: 1.8rem;
  color: #555;
  margin-bottom: 1.2rem;
  line-height: 1.6;
}

/* Checklist */
.checklist {
  list-style: none;
  padding: 0;
  margin-bottom: 1.5rem;
}

.checklist li {
  position: relative;
  padding-left: 2rem;
  margin-bottom: 0.8rem;
  font-size: 1.5rem;
  color: #333;
}

.checklist li::before {
  content: "✔";
  position: absolute;
  left: 0;
  top: 0;
  color: green;
  font-weight: bold;
}

/* Image Wrapper */
.image-wrapper {
  flex: 1;
  position: relative;
  width: 100%;
  margin: 0;
  z-index: 2;
}

.rectangle-bg {
  position: absolute;
  top: 40px;
  left: 0;
  width: 100%;
  height: 300px;
  background-color: #f3f3f3;
  z-index: 1;
  border-radius: 12px;
}

.column-image {
  position: relative;
  z-index: 2;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 12px;
}

.column-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 12px;
  display: block;
  transition: opacity 0.5s ease-in-out;
  position: absolute;
  top: 0;
  left: 0;
}

.column-image .main-img {
  opacity: 1;
  z-index: 1;
}

.column-image .hover-img {
  opacity: 0;
  z-index: 2;
}

.column-image:hover .main-img {
  opacity: 0;
}

.column-image:hover .hover-img {
  opacity: 1;
}

/* Button */
.btn {
  display: inline-block;
  padding: 12px 28px;
  border : 2px solid black;
  color: #000;
  text-decoration: none;
  font-weight: 600;
  border-radius: 6px;
  transition: all 0.3s ease;
}

.btn:hover {
  background-color: #000;
  color:#fff;
  transform: translateY(-2px);
}

/* Responsive */
@media screen and (max-width: 768px) {
  .single-column,
  .single-column.reverse {
    flex-direction: column;
    text-align: center;
  }

  .image-wrapper {
    width: 100%;
  }

  .rectangle-bg {
    height: 200px;
    top: 20px;
  }

  .text-content {
    text-align: center;
  }

  .btn {
    padding:10px 15px;
    font-size:1.3rem;
  }

  .text-content h3 {
    font-size: 2.5rem;
  }

  .text-content .subtext {
    font-size: 1.4rem;
    color: #555;
    margin-bottom: 1.2rem;
    line-height: 1.6;
  }

  /* Checklist aligned left */
  .checklist {
    text-align: left;
  }

  .checklist li {
    text-align: left;
    display: list-item; /* ensures proper list behavior */
    font-size: 1.2rem;
    padding-left: 2rem; /* keeps the checkmark aligned */
  }
}

</style>

{% schema %}
{
  "name": "Customer Planter Boxes",
  "settings": [
    {
      "type": "checkbox",
      "id": "swap_order",
      "label": "Swap Text and Image Position",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "hover_image",
      "label": "Hover Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom Planter Boxes"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Tailored planter boxes and large-scale solutions designed to suit your unique style and needs."
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Now"
    },
    {
      "type": "select",
      "id": "button_action",
      "label": "Button Action",
      "options": [
        { "value": "scroll", "label": "Scroll to Enquiry Form" },
        { "value": "link", "label": "Go to a Page" },
        { "value": "collection", "label": "Scroll to Planter Boxes Grid" }
      ],
      "default": "link"
    }
    ,
    {
      "type": "url",
      "id": "button_link",
      "label": "Page Link (used if 'Go to a Page' is selected)"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Bullet Text",
          "default": "Example bullet item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Planters Boxes Gallery",
      "blocks": [
        { "type": "bullet" },
        { "type": "bullet" }
      ]
    }
  ]
}
{% endschema %}

