{% schema %}
{
  "name": "All Collections Row",
  "settings": [],
  "presets": [
    {
      "name": "All Collections"
    }
  ]
}
{% endschema %}

<div class="collections-row-section">
  <h2 class="collections-heading">View our Collections</h2>

  <div class="collections-container">
    <div class="collections-row">
      {% assign total = collections | size %}
      {% for collection in collections %}
        <a href="{{ collection.url }}" class="collection-card" style="flex: 1 1 calc(100% / {{ total }} - 20px);">
          <div class="collection-image-wrapper">
            {% if collection.image %}
              <img src="{{ collection.image | img_url: '600x600' }}" alt="{{ collection.title }}" class="collection-image" />
            {% else %}
              <img src="{{ collection.products.first.featured_image | img_url: '600x600' }}" alt="{{ collection.title }}" class="collection-image" />
            {% endif %}
          </div>
          <div class="collection-title">{{ collection.title }}</div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Section & Heading */
.collections-row-section {
  padding: 50px 20px;
  background-color: #fff;
}

.collections-heading {
  text-align: center;
  font-size: 3.5rem;
  margin-bottom: 40px;
  font-family: "Montserrat", sans-serif;
  font-weight: 700;
  color: #111;
}

/* Container & Row */
.collections-container {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.collections-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
}

/* Collection Card */
.collection-card {
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  text-decoration: none;
  color: inherit;
  border-radius: 12px;
}

.collection-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.1);
}

/* Image Wrapper - Square & Equal */
.collection-image-wrapper {
  width: 100%;
  padding-top: 100%; /* 1:1 Aspect Ratio */
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  background-color: #f5f5f5;
}

.collection-image-wrapper img.collection-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover; /* Fill square */
  transition: transform 0.4s ease;
  display: block;
}

.collection-card:hover .collection-image {
  transform: scale(1.1);
}

/* Title */
.collection-title {
  margin-top: 12px;
  font-size: 1.6rem;
  font-weight: 600;
  color: #333;
  font-family: "Montserrat", sans-serif;
}

/* --- Responsive --- */
@media (max-width: 1024px) {
  .collections-row {
    gap: 15px;
  }
  .collections-heading {
    font-size: 3rem;
  }
  .collection-title {
    font-size: 1.4rem;
  }
}

@media (max-width: 768px) {
  .collections-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }
  .collection-card {
    flex: none !important;
  }
  .collections-heading {
    font-size: 2.5rem;
  }
  .collection-title {
    font-size: 1.3rem;
  }
  .collection-card:hover .collection-image {
    transform: none; /* disable hover zoom on mobile */
  }
}

@media (max-width: 480px) {
  .collections-row {
    grid-template-columns: 1fr;
  }
  .collections-heading {
    font-size: 2rem;
  }
  .collection-title {
    font-size: 1.2rem;
  }
}
</style>
